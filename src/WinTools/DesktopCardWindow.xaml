<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinTools.DesktopCardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinTools"
    Title="桌面卡片">

    <!-- 外轮廓只由 DWM 的 12px 窗口圆角负责；XAML 表面不再重复画圆角或描边。 -->
    <!-- 点在图标以外的地方要清掉选中（和 Windows 桌面一致）。这个 Tapped 处理器不在这里挂，
         而是在构造函数里 AddHandler(handledEventsToo: true)：GridView 会把落在自己空白处的
         Tapped 标记为已处理，普通挂钩根本收不到。 -->
    <Grid x:Name="ShellRoot" Background="Transparent" Padding="0">
        <Border x:Name="CardSurface"
                Background="{ThemeResource CodexSurfaceBrush}"
                BorderThickness="0" CornerRadius="0">
            <!-- 四边同一个内边距。卡片尺寸由 ApplyAutoSize 按 GridPadding 算出来，
                 这里改了那边也要改。 -->
            <Grid Padding="8">
                    <TextBlock x:Name="EmptyHint" Text="这个分区还没有文件。"
                               Opacity="0.5" FontSize="12" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <!-- SelectionMode=Single：单击选中并保留高亮（此前是 None，只有 hover 才有反馈，
                         松开鼠标就什么都看不出来，用户无法判断自己选中了哪个）。
                         双击打开由 CardRoot_PointerPressed 按系统双击时间与距离判断（不用 DoubleTapped）。 -->
                    <!-- CanReorderItems 必须保持 True，但真正执行卡片内重排的是 code-behind 的
                         ReorderWithinCard：内置重排只认 ItemsWrapGrid，换成 CardTilesPanel 后它不再
                         插入；而一旦设成 False，拖动会话就不再把 DragOver/Drop 发回源列表，
                         自己处理也收不到（2026-09-18 埋点实测）。 -->
                    <GridView x:Name="ItemsGrid" SelectionMode="Single" IsItemClickEnabled="True"
                              UseSystemFocusVisuals="False"
                              SelectionChanged="ItemsGrid_SelectionChanged"
                              CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                              DragItemsStarting="ItemsGrid_DragItemsStarting"
                              DragItemsCompleted="ItemsGrid_DragItemsCompleted"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Padding="0">
                        <GridView.Resources>
                            <!-- 图标的三种底色，与 Windows 文件列表一致（灰色，不用主题色）：
                                 悬停：浅灰；选中：中灰；选中后再悬停：浅灰；离开悬停且未选中：无底色。
                                 深浅两套主题分别取值，深色用白色叠加，浅色用黑色叠加。 -->
                            <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Dark">
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#14FFFFFF"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#33FFFFFF"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#14FFFFFF"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#33FFFFFF"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="#33FFFFFF"/>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#0F000000"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#29000000"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#0F000000"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#29000000"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="#29000000"/>
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </GridView.Resources>
                        <GridView.ItemContainerStyle>
                            <!-- 关键：清掉 WinUI 3 默认 GridViewItem 的内边距 + 默认 Center 内容对齐，
                                 让所有 item 紧贴 GridView 左边缘开始排，单图标固定在卡片最左。
                                 之前设的 HorizontalContentAlignment="Center" 会让单图标居中，
                                 跟"固定宽度靠左"的卡片风格不符。 -->
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="CornerRadius" Value="{StaticResource PageInnerCornerRadius}"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <!-- 不要焦点框：鼠标点击后 WinUI 会在图标外画一圈强调色（蓝框），Windows 桌面图标没有这圈框。
                                     焦点仍然在，只是框线透明，方向键和 Enter 照常工作。 -->
                                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                                <Setter Property="FocusVisualPrimaryBrush" Value="Transparent"/>
                                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 自定义换行面板：列宽固定 76dip，**每行高度取该行最高的格子**。
                                     ItemsWrapGrid 是均匀网格，所有格子必须同尺寸，于是每一行都要按
                                     "两行文件名"预留高度，单行文件名的行下面就空一截。详见
                                     CardTilesPanel 的注释。 -->
                                <local:CardTilesPanel ItemWidth="76" HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:CardItem">
                                <!-- 不写固定 Height：格子的高度由内容决定（文件名占 1 行还是 2 行），
                                     CardTilesPanel 按每行最高的格子决定这一行的高度。 -->
                                <!-- 右键菜单不写在模板里：每个图标各带一份菜单实测多占约 4MB。
                                     菜单在 GridView 的 ContextRequested 里按需创建（DesktopCardWindow.ItemMenu.cs）。 -->
                                <StackPanel Width="76" Spacing="4" Padding="4,8" Tag="{x:Bind}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="{x:Bind DisplayName}" Style="{StaticResource PageDesktopToolTipStyle}"/>
                                    </ToolTipService.ToolTip>
                                    <!-- 不再用 FontIcon 作 fallback：SHGetFileInfo 已经能
                                         稳定拿真实图标，fallback 反而让用户觉得"图标覆盖"在
                                         原线框文件图标上。Image 直接撑满容器。 -->
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="36" Height="36"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Stretch="Uniform"/>
                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="11"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
            </Grid>
        </Border>
    </Grid>
</Window>
