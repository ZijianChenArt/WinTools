<UserControl
    x:Class="WinTools.ClipboardHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:WinTools.Services">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="HistoryToolbar" ColumnSpacing="8" Margin="0,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="HeaderDragRegion" ColumnSpacing="8" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PopupTitle" Text="剪贴板历史" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="选择一条记录以复制"
                           Style="{StaticResource PageCaptionTextStyle}" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite"/>
            </Grid>
            <Button x:Name="ClearButton" Grid.Column="1" Content="清空历史" IsEnabled="False" Click="Clear_Click"/>
            <Button x:Name="PopupCloseButton" Grid.Column="2" Visibility="Collapsed"
                    Style="{StaticResource PageToolbarIconButtonStyle}" Width="28" Height="28" MinWidth="0" MinHeight="0"
                    AutomationProperties.Name="关闭" ToolTipService.ToolTip="关闭" Click="PopupClose_Click">
                <FontIcon Glyph="&#xE711;" FontSize="14"/>
            </Button>
        </Grid>
        <Border x:Name="HistorySurface" Grid.Row="1" CornerRadius="{StaticResource PageInnerCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="EmptyText" Text="还没有剪贴记录"
                       Style="{StaticResource PageCaptionTextStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <ListView x:Name="HistoryList" IsItemClickEnabled="True" SelectionMode="None"
                      Margin="0,0,4,0" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ItemClick="History_ItemClick" AutomationProperties.Name="剪贴板历史">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,5"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="CornerRadius" Value="{StaticResource PageInnerCornerRadius}"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:ClipboardHistoryItem">
                        <Border Style="{StaticResource ClipboardHistoryRowStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{x:Bind Thumbnail}" Visibility="{x:Bind ThumbnailVisibility}"
                                       Width="24" Height="24" Stretch="Uniform"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Summary}" VerticalAlignment="Center" FontSize="13"
                                           TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Style="{StaticResource PageToolbarIconButtonStyle}" VerticalAlignment="Center"
                                        Width="30" Height="28" MinWidth="0" MinHeight="0"
                                        AutomationProperties.Name="删除记录" ToolTipService.ToolTip="删除记录"
                                        Click="Delete_Click" Tag="{x:Bind}">
                                    <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>
                <ScrollBar x:Name="HistoryScrollBar" Grid.Column="1" Orientation="Vertical" Visibility="Collapsed" IsTabStop="False"
                           AutomationProperties.Name="剪贴板历史滚动条"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
