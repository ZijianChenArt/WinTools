<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinTools</RootNamespace>
    <Version>1.2.18</Version>
    <AssemblyVersion>1.2.18.0</AssemblyVersion>
    <FileVersion>1.2.18.0</FileVersion>
    <InformationalVersion>1.2.18</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- 普通 Build/调试是可直接运行的 unpackaged 应用；MSIX 发布时由发布命令显式覆盖。 -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <AppxPackage Condition="'$(AppxPackage)' == ''">false</AppxPackage>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 发布包携带 Windows App Runtime，目标电脑无需另外安装运行时。 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\WinToolsExplorerCommand\bin\$(Platform)\$(Configuration)\WinToolsExplorerCommand.dll"
             Link="WinToolsExplorerCommand.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 保留 Visual Studio 的 MSIX 发布入口；普通 Build 不再隐式导入发布配置。 -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- 发布属性（WinUI 不建议启用 Trimmed/R2R，一般 build 不跑发布） -->
  <PropertyGroup>
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!-- Release 成品不携带调试符号；WinUI 3 不启用不安全的程序集裁剪。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>False</DebugSymbols>
  </PropertyGroup>

  <!-- 发布时只保留简体中文资源（.NET 卫星程序集） -->
  <PropertyGroup>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 排除临时重命名的旧 obj/bin 与 _zbak / _bak / .old 后缀目录：默认排除只覆盖 bin/obj/.vs 等，否则会被 SDK 当作源文件 -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj.old\**;bin.old\**;obj.old.bak\**;bin.old.bak\**;_bak_*/**;_zbak/**;_zSettings/**;*_zbak/**;obj_keep/**;bin_keep/**;obj_x64_bak/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 发布后仅保留 zh-CN 语言文件夹 -->
  <Target Name="RemoveExtraLanguageFoldersAfterPublish" AfterTargets="Publish">
    <Exec Condition="'$(PublishDir)' != ''" WorkingDirectory="$(ProjectDir)" Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)scripts\Remove-ExtraLanguageFolders.ps1&quot; -PublishDir &quot;$(PublishDir)&quot;" IgnoreExitCode="true" />
  </Target>
</Project>
