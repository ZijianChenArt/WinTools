<?xml version="1.0" encoding="utf-8"?>
<!--
    文件预览窗口（桌面卡片里选中文件按空格呼出，仿 QuickLook）。
    独立浮层，排版使用 Styles/PageStyles.xaml 中的 Preview 样式；尺寸由
    FilePreviewWindow.xaml.cs 按工作区算出。窗口隐藏时会释放解码器与位图，常驻内存只剩窗口本身。
-->
<Window
    x:Class="WinTools.FilePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="文件预览">

    <Grid x:Name="ShellRoot" PreviewKeyDown="ShellRoot_PreviewKeyDown">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- 单行标题：文件名和元数据在左，必要操作在右；拖动区仅覆盖名称，避免吞掉按钮点击。 -->
        <Grid x:Name="HeaderBar" Style="{StaticResource PreviewHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="HeaderDragRegion"><TextBlock x:Name="TitleText" Style="{StaticResource PreviewTitleStyle}"/></Grid>
            <TextBlock x:Name="MetaText" Grid.Column="1" Style="{StaticResource PreviewCaptionStyle}"/>
        <Grid x:Name="PreviewToolbar" Grid.Column="2" Style="{StaticResource PreviewToolbarStyle}" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SourceButton" Content="源码" Style="{StaticResource PreviewActionStyle}" Visibility="Collapsed"
                        Click="SourceButton_Click" ToolTipService.ToolTip="切换阅读视图与原文"/>
                <Button x:Name="WrapButton" Content="自动换行" Style="{StaticResource PreviewActionStyle}" Visibility="Collapsed"
                        Click="WrapButton_Click" ToolTipService.ToolTip="切换长行自动换行"/>
                <Button x:Name="ListUpButton" Content="上一级" Style="{StaticResource PreviewActionStyle}" Visibility="Collapsed" Click="ListUpButton_Click"/>
                <ComboBox x:Name="SheetSelector" Style="{StaticResource PreviewSheetSelectorStyle}" Visibility="Collapsed"
                          SelectionChanged="SheetSelector_SelectionChanged" AutomationProperties.Name="工作表"/>
            </StackPanel>
            <TextBlock x:Name="ViewStatus" Visibility="Collapsed" Grid.Column="1" Style="{StaticResource PreviewViewStatusStyle}"/>
            <StackPanel x:Name="ZoomTools" Grid.Column="2" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                <Button Content="−" Style="{StaticResource PreviewActionStyle}" Click="ZoomOut_Click" ToolTipService.ToolTip="缩小" AutomationProperties.Name="缩小"/>
                <Button Content="适合" Style="{StaticResource PreviewActionStyle}" Click="ZoomFit_Click" ToolTipService.ToolTip="适合窗口"/>
                <Button Content="+" Style="{StaticResource PreviewActionStyle}" Click="ZoomIn_Click" ToolTipService.ToolTip="放大" AutomationProperties.Name="放大"/>
            </StackPanel>
        </Grid>
            <Button x:Name="HeaderHelp" Grid.Column="3" Content="?" Style="{StaticResource PreviewActionStyle}" AutomationProperties.Name="快捷键帮助">
                <Button.Flyout><Flyout><TextBlock x:Name="ShortcutHelp" TextWrapping="Wrap" Style="{StaticResource PreviewHelpTextStyle}"/></Flyout></Button.Flyout>
            </Button>
            <Button x:Name="HeaderOpen" Grid.Column="4" Content="打开" Style="{StaticResource PreviewActionStyle}"
                    Click="OpenButton_Click" ToolTipService.ToolTip="用默认程序打开（Enter）"/>
        </Grid>
        <!-- 内容区：同一时间只显示其中一个。 -->
        <Grid x:Name="ContentHost" Grid.Row="1" Style="{StaticResource PreviewContentStyle}" SizeChanged="ContentHost_SizeChanged">
            <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="False" Visibility="Collapsed"/>

            <ScrollViewer x:Name="ImageSurface" Visibility="Collapsed" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="8"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="ImageView" Stretch="Uniform"/>
            </ScrollViewer>

            <ScrollViewer x:Name="ReadingView" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto" Style="{StaticResource PreviewTextSurfaceStyle}">
                <StackPanel x:Name="ReadingBody" Style="{StaticResource PreviewReadingBodyStyle}"/>
            </ScrollViewer>

            <Grid x:Name="ListSurface" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Style="{StaticResource PreviewListHeaderStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <TextBlock Text="名称" Style="{StaticResource PreviewCaptionStyle}"/>
                    <TextBlock Text="大小 / 类型" Grid.Column="1" Style="{StaticResource PreviewCaptionStyle}"/>
                </Grid>
                <ListView x:Name="EntryList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="EntryList_ItemClick"
                          ItemContainerStyle="{StaticResource PreviewListItemStyle}" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Height="32">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{Binding Glyph}" Style="{StaticResource PreviewMediaGlyphStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource PreviewListTextStyle}" ToolTipService.ToolTip="{Binding Path}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource PreviewCaptionStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EntryEmpty" Grid.Row="1" Text="此目录为空。" Visibility="Collapsed" Style="{StaticResource PreviewEmptyStyle}"/>
            </Grid>

            <ScrollViewer x:Name="TableSurface" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="TableGrid">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="TableHeader" Style="{StaticResource PreviewTableHeaderStyle}"/>
                    <ListView x:Name="TableRows" Grid.Row="1" SelectionMode="None" HorizontalContentAlignment="Stretch"
                              ItemContainerStyle="{StaticResource PreviewListItemStyle}"/>
                    <TextBlock x:Name="TableEmpty" Grid.Row="1" Text="此表格为空。" Visibility="Collapsed" Style="{StaticResource PreviewEmptyStyle}"/>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="TextView" Visibility="Collapsed"
                          Style="{StaticResource PreviewTextSurfaceStyle}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ZoomMode="Disabled">
                <TextBlock x:Name="TextBody" Style="{StaticResource PreviewTextStyle}" TextWrapping="NoWrap"/>
            </ScrollViewer>

            <!-- PDF：所有页竖排，滚动时才渲染视口附近的页。 -->
            <ScrollViewer x:Name="PdfView" Visibility="Collapsed" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="4"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ViewChanged="PdfView_ViewChanged">
                <StackPanel x:Name="PdfPages" Spacing="12" HorizontalAlignment="Center"/>
            </ScrollViewer>

            <!-- HTML：WebView2 渲染，第一次打开 HTML 时才初始化。 -->
            <controls:WebView2 x:Name="HtmlView" Visibility="Collapsed"/>

            <!-- 播放条单独占 48 DIP，不覆盖视频，也不使用系统播放器的多行工具栏。 -->
            <Grid x:Name="MediaSurface" Visibility="Collapsed" RowSpacing="0" SizeChanged="MediaSurface_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel x:Name="AudioInfo" Visibility="Collapsed" Style="{StaticResource PreviewAudioInfoStyle}">
                        <FontIcon Glyph="&#xE8D6;" Style="{StaticResource PreviewAudioIconStyle}"/>
                        <TextBlock x:Name="AudioTitle" Style="{StaticResource PreviewFallbackTitleStyle}"/>
                    </StackPanel>
                    <MediaPlayerElement x:Name="MediaView" AreTransportControlsEnabled="False" Stretch="Uniform"/>
                </Grid>
                <Border x:Name="MediaBar" Grid.Row="1" Style="{StaticResource PreviewMediaBarStyle}"
                        HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayButton" Style="{StaticResource PreviewMediaButtonStyle}"
                                Click="PlayButton_Click" AutomationProperties.Name="播放" ToolTipService.ToolTip="播放 / 暂停">
                            <FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" Style="{StaticResource PreviewMediaGlyphStyle}"/>
                        </Button>
                        <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                                Style="{StaticResource PreviewMediaSliderStyle}"
                                MinWidth="48" IsEnabled="False" VerticalAlignment="Center"
                                IsThumbToolTipEnabled="False" ValueChanged="SeekSlider_ValueChanged"
                                AutomationProperties.Name="播放进度"/>
                        <TextBlock x:Name="MediaTimeText" Grid.Column="2" Text="0:00 / 0:00"
                                   Style="{StaticResource PreviewCaptionStyle}"/>
                        <Button x:Name="MuteButton" Grid.Column="3" Style="{StaticResource PreviewMediaButtonStyle}"
                                Click="MuteButton_Click" AutomationProperties.Name="静音" ToolTipService.ToolTip="静音 / 恢复音量">
                            <FontIcon x:Name="MuteGlyph" Glyph="&#xE767;" Style="{StaticResource PreviewMediaGlyphStyle}"/>
                        </Button>
                        <Slider x:Name="VolumeSlider" Grid.Column="4" Width="72" Value="100" Minimum="0" Maximum="100"
                                Style="{StaticResource PreviewMediaSliderStyle}"
                                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"
                                AutomationProperties.Name="音量"/>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer x:Name="FallbackPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="480" Padding="24" ColumnSpacing="20" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="FallbackIcon" Width="64" Height="64" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="FallbackTitle" Style="{StaticResource PreviewFallbackTitleStyle}"/>
                        <TextBlock x:Name="FallbackHint" Style="{StaticResource PreviewFallbackHintStyle}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 焦点承接：窗口激活后把键盘焦点放在这里，之后的按键才会走 PreviewKeyDown。 -->
            <Button x:Name="KeyCatcher" Opacity="0" IsHitTestVisible="False" Width="1" Height="1"
                    Padding="0" MinWidth="0" MinHeight="0" BorderThickness="0"/>
        </Grid>

        <!-- 状态字段用于组合顶部提示，不占据额外一行。 -->
        <Grid x:Name="FooterBar" Visibility="Collapsed">
            <TextBlock x:Name="HintText"/>
            <TextBlock x:Name="FooterText"/>
        </Grid>
    </Grid>
</Window>
