<?xml version="1.0" encoding="utf-8"?>
<!--
    文件预览窗口（桌面卡片里选中文件按空格呼出，仿 QuickLook）。
    独立浮层，与悬浮搜索一样不走 Styles/PageStyles.xaml 的页面令牌；尺寸由
    FilePreviewWindow.xaml.cs 按工作区算出。窗口隐藏时会释放解码器与位图，常驻内存只剩窗口本身。
-->
<Window
    x:Class="WinTools.FilePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="文件预览">

    <Grid x:Name="ShellRoot" PreviewKeyDown="ShellRoot_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏：拖动窗口用，没有系统按钮。 -->
        <Grid x:Name="HeaderBar" Grid.Row="0" Height="44" Padding="16,0,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Grid.Column="0" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <!-- 与 QuickLook 一样，文件大小（图片、视频再加像素尺寸）紧跟文件名显示。 -->
            <TextBlock x:Name="MetaText" Grid.Column="1" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="HintText" Grid.Column="2" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="空格 / Esc 关闭 · ← → 切换 · Enter 打开"/>
        </Grid>

        <!-- 内容区：同一时间只显示其中一个。 -->
        <Grid x:Name="ContentHost" Grid.Row="1" Margin="12,0,12,0">
            <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="False" Visibility="Collapsed"/>

            <Image x:Name="ImageView" Stretch="Uniform" Visibility="Collapsed"
                   ImageFailed="ImageView_ImageFailed"/>

            <ScrollViewer x:Name="TextView" Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ZoomMode="Disabled">
                <TextBlock x:Name="TextBody" FontFamily="Consolas" FontSize="13"
                           TextWrapping="NoWrap" IsTextSelectionEnabled="True" Margin="8"/>
            </ScrollViewer>

            <!-- PDF：所有页竖排，滚动时才渲染视口附近的页。 -->
            <ScrollViewer x:Name="PdfView" Visibility="Collapsed" ZoomMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          ViewChanged="PdfView_ViewChanged">
                <StackPanel x:Name="PdfPages" Spacing="12" HorizontalAlignment="Center"/>
            </ScrollViewer>

            <!-- HTML：WebView2 渲染，第一次打开 HTML 时才初始化。 -->
            <controls:WebView2 x:Name="HtmlView" Visibility="Collapsed"/>

            <MediaPlayerElement x:Name="MediaView" Visibility="Collapsed"
                                AreTransportControlsEnabled="True" AutoPlay="True"/>

            <StackPanel x:Name="FallbackPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Image x:Name="FallbackIcon" Width="96" Height="96"/>
                <TextBlock x:Name="FallbackTitle" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="FallbackHint" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="420"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 焦点承接：窗口激活后把键盘焦点放在这里，之后的按键才会走 PreviewKeyDown。 -->
            <Button x:Name="KeyCatcher" Opacity="0" IsHitTestVisible="False" Width="1" Height="1"
                    Padding="0" MinWidth="0" MinHeight="0" BorderThickness="0"/>
        </Grid>

        <TextBlock x:Name="FooterText" Grid.Row="2" FontSize="12" Margin="16,8,16,12"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Window>
