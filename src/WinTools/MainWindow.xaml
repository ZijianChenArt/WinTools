<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinTools"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinTools - Windows 工具集">

    <Grid x:Name="ShellRoot" MinWidth="560" UseLayoutRounding="True"
          Background="Transparent">
        <Grid.Resources>
            <!-- 本地可变画刷：主题切换时仅更新 Color，避免重复插入 ResourceDictionary 键。 -->
            <SolidColorBrush x:Key="CodexContentMicaBrush" Color="#80181818"/>
            <SolidColorBrush x:Key="CodexSidebarBrush" Color="#1C2230"/>
            <SolidColorBrush x:Key="CodexSurfaceBrush" Color="#242424"/>
            <SolidColorBrush x:Key="CodexBorderBrush" Color="#383838"/>
            <!--
                排版、卡片、间距、圆角统一由 Styles/PageStyles.xaml 提供（PageTitleTextStyle /
                PageSubtitleTextStyle / PageCardStyle / NavigationLabelStyle 等）。
                这里只保留需要在主题切换时改 Color 的本地画刷，不要再复制一份样式。
            -->
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 40dip：对齐文件资源管理器的标签栏（实测 50 物理像素 @125% = 40dip）。
             系统按钮仍是 Standard 的 32dip、贴顶部绘制，资源管理器也是这样（实测按钮 28.8dip）。
             所以这里**不能**再让 HookTitleBarPadding 去同步系统标题栏高度，高度以本行为准。 -->
        <Grid x:Name="AppTitleBar" Height="40" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <!-- 左边距 6：侧栏 CompactPaneLength 是 48，图标列中心在 24；
                     开关按钮宽 36，中心 = 6 + 18 = 24，两者才对得上一条竖线。
                     曾经是 4，实测汉堡图标中心比下面的导航图标偏左 2px。 -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button Width="36" Height="32"
                            Background="Transparent" BorderThickness="0" CornerRadius="10"
                            VerticalAlignment="Center"
                            Click="TitleBarPaneToggle_Click"
                            ToolTipService.ToolTip="展开或收起侧边栏">
                        <!-- FontSize 16：15dip 在 125% 下是 18.75 物理像素卡半像素，16dip = 20px
                             落在网格上，墨迹大小也和侧栏导航图标接近。
                             Margin 顶部 2：图标字体的墨迹是贴基线往上长的，行盒居中会让它比右边的
                             logo 和文字高约 1.5 物理像素（实测中心 19.0 vs 20.5）。居中元素的上边距
                             只生效一半，所以 2dip 正好把它压回同一条线。 -->
                        <FontIcon Glyph="&#xE700;" FontSize="16" Margin="0,2,0,0"/>
                    </Button>
                    <!-- 16 而不是 18：18dip 在 125% 缩放下是 22.5 物理像素，卡在半像素上，
                         上下抗锯齿不对称，看起来比旁边的图标低一点。16dip = 20px 正好落在像素网格上。 -->
                    <Image Source="Assets/logo.png" Width="16" Height="16" VerticalAlignment="Center"/>
                    <!-- TextLineBounds="Tight"：默认的 Full 会把 ascent/descent 的空白算进行盒，
                         "WinTools" 没有下伸部，居中行盒等于把字形墨迹压低约 1.5px，和左边的汉堡
                         图标差出肉眼可见的一条线。Tight 让行盒贴住墨迹，居中才是真的居中。 -->
                    <TextBlock Text="WinTools" FontSize="14" FontWeight="SemiBold"
                               TextLineBounds="Tight" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <NavigationView x:Name="MainNav" Grid.Row="1" Margin="0,-1,0,0"
            Background="Transparent"
            PaneDisplayMode="Auto"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            IsPaneOpen="True"
            OpenPaneLength="224"
            CompactPaneLength="48"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="840"
            SelectionFollowsFocus="Disabled">

            <!-- 侧栏/内容区背景透明，透出父级 ThemeResource；勿用 StaticResource 绑定主题色（会在加载时锁死系统主题） -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="MinHeight" Value="40"/>
                    <Setter Property="Margin" Value="4,2"/>
                    <Setter Property="CornerRadius" Value="10"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
                <Style TargetType="FontIcon">
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemThreeFingerDrag" Tag="ThreeFingerDrag">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind local:FeatureIcons.ThreeFingerDrag}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="三指拖拽" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotThreeFingerDrag" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemDragStash" Tag="DragStash">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind local:FeatureIcons.DragStash}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="悬浮暂存" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotDragStash" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemProgramAssoc" Tag="ProgramAssociation">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind local:FeatureIcons.ProgramAssociation}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="程序关联" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotProgramAssoc" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemPerAppIme" Tag="PerAppIme">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind local:FeatureIcons.InputMethod}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输入法切换" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotPerAppIme" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemDesktopOrganize" Tag="DesktopOrganize">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind local:FeatureIcons.DesktopCards}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="桌面分区" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotDesktopOrganize" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemDesktopClick" Tag="DesktopClick">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind local:FeatureIcons.DesktopClick}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="双击桌面" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotDesktopClick" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemSpacePreview" Tag="SpacePreview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind local:FeatureIcons.SpacePreview}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="空格预览" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotSpacePreview" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemSpotlight" Tag="Spotlight">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind local:FeatureIcons.Search}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="悬浮搜索" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotSpotlight" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemVoiceBall" Tag="VoiceBall">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind local:FeatureIcons.Voice}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="语音小球" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotVoiceBall" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemTaskbarInfo" Tag="TaskbarInfo">
                    <NavigationViewItem.Icon><FontIcon Glyph="{x:Bind local:FeatureIcons.TaskbarInfo}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}"/></NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="任务栏信息" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotTaskbarInfo" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemAppSettings" Tag="AppSettings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind local:FeatureIcons.Settings}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="设置" Style="{StaticResource NavigationLabelStyle}"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 侧栏与内容区之间不画分割线：靠底色差异区分，避免出现细黑线。 -->
            <Border x:Name="ContentFrame"
                    Background="{ThemeResource CodexContentMicaBrush}"
                    BorderThickness="0"
                    CornerRadius="12,0,0,0"
                    Padding="0">
                <Grid x:Name="PageViewport"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <local:FeaturePagesHost x:Name="FeaturePages"/>
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>
