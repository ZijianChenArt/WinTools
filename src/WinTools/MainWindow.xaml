<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinTools"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinTools - Windows 工具集">

    <Grid x:Name="ShellRoot" MinWidth="560" UseLayoutRounding="True"
          Background="Transparent">
        <Grid.Resources>
            <!-- 本地可变画刷：主题切换时仅更新 Color，避免重复插入 ResourceDictionary 键。 -->
            <SolidColorBrush x:Key="CodexContentMicaBrush" Color="#80181818"/>
            <SolidColorBrush x:Key="CodexSidebarBrush" Color="#1C2230"/>
            <SolidColorBrush x:Key="CodexSurfaceBrush" Color="#242424"/>
            <SolidColorBrush x:Key="CodexBorderBrush" Color="#383838"/>
            <!--
                排版、卡片、间距、圆角统一由 Styles/PageStyles.xaml 提供（PageTitleTextStyle /
                PageSubtitleTextStyle / PageCardStyle / NavigationLabelStyle 等）。
                这里只保留需要在主题切换时改 Color 的本地画刷，不要再复制一份样式。
            -->
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 48px 加高标题栏：左侧应用标识 + 侧栏开关，居中全局搜索框（与参考设置页一致）。 -->
        <Grid x:Name="AppTitleBar" Height="48" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!--
                标题栏内容分两栏：左侧标识固定宽度，搜索框占剩余空间。
                窄窗口下搜索框会先缩小、再由 MainWindow 的 SizeChanged 整块隐藏，
                否则它会和左侧标识、窗口按钮叠在一起。
            -->
            <Grid Grid.Column="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                            Margin="4,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button Width="36" Height="32"
                            Background="Transparent" BorderThickness="0" CornerRadius="10"
                            VerticalAlignment="Center"
                            Click="TitleBarPaneToggle_Click"
                            ToolTipService.ToolTip="展开或收起侧边栏">
                        <FontIcon Glyph="&#xE700;" FontSize="15"/>
                    </Button>
                    <Image Source="Assets/logo.png" Width="18" Height="18" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AppTitleText" Text="WinTools" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 窄窗口下搜索框收成一个放大镜按钮，点一下再展开成输入框 -->
                <Button x:Name="ShellSearchButton" Grid.Column="1" Width="36" Height="32"
                        Background="Transparent" BorderThickness="0" CornerRadius="10"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                        Visibility="Collapsed" Click="ShellSearchButton_Click"
                        ToolTipService.ToolTip="搜索功能与设置">
                    <FontIcon Glyph="&#xE721;" FontSize="15"/>
                </Button>

                <Grid x:Name="ShellSearchHost" Grid.Column="1" MinWidth="160" MaxWidth="480" Height="32"
                      Margin="0,0,12,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE721;" FontSize="13" HorizontalAlignment="Right"
                              Margin="0,0,12,0" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              IsHitTestVisible="False" Canvas.ZIndex="1"/>
                    <AutoSuggestBox x:Name="ShellSearchBox"
                                    PlaceholderText="搜索功能与设置"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="16" Padding="14,0,34,0"
                                    TextChanged="ShellSearch_TextChanged"
                                    QuerySubmitted="ShellSearch_QuerySubmitted"
                                    SuggestionChosen="ShellSearch_SuggestionChosen"/>
                </Grid>
            </Grid>
        </Grid>

        <NavigationView x:Name="MainNav" Grid.Row="1" Margin="0,-1,0,0"
            Background="Transparent"
            PaneDisplayMode="Auto"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            IsPaneOpen="True"
            OpenPaneLength="224"
            CompactPaneLength="48"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="840"
            SelectionFollowsFocus="Disabled">

            <!-- 侧栏/内容区背景透明，透出父级 ThemeResource；勿用 StaticResource 绑定主题色（会在加载时锁死系统主题） -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="MinHeight" Value="40"/>
                    <Setter Property="Margin" Value="4,2"/>
                    <Setter Property="CornerRadius" Value="10"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
                <Style TargetType="SymbolIcon">
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemQuickSettings" Tag="QuickSettings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="快捷设置" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotQuickSettings" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemThreeFingerDrag" Tag="ThreeFingerDrag">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="TouchPointer"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="三指拖拽" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotThreeFingerDrag" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemDragStash" Tag="DragStash">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pin"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="悬浮暂存" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotDragStash" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemProgramAssoc" Tag="ProgramAssociation">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="OpenFile"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="程序关联" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotProgramAssoc" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemPerAppIme" Tag="PerAppIme">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Keyboard"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输入法切换" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotPerAppIme" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemDesktopOrganize" Tag="DesktopOrganize">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="ViewAll"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="桌面分区" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotDesktopOrganize" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemDesktopClick" Tag="DesktopClick">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="点击桌面" Style="{StaticResource NavigationLabelStyle}"/>
                            <Ellipse x:Name="NavDotDesktopClick" Grid.Column="1" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemAppSettings" Tag="AppSettings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="设置" Style="{StaticResource NavigationLabelStyle}"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 侧栏与内容区之间不画分割线：靠底色差异区分，避免出现细黑线。 -->
            <Border x:Name="ContentFrame"
                    Background="{ThemeResource CodexContentMicaBrush}"
                    BorderThickness="0"
                    CornerRadius="12,0,0,0"
                    Padding="0">
                <Grid x:Name="PageViewport"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <local:FeaturePagesHost x:Name="FeaturePages"/>
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>

