<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinTools.FloatingStashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinTools"
    Title="悬浮暂存">

    <Grid x:Name="ShellRoot" MinWidth="260" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 统一透明标题栏（与 MainWindow 一致） -->
        <Grid x:Name="AppTitleBar" Height="48" Grid.Row="0"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="悬浮暂存" VerticalAlignment="Center" Margin="18,0,0,0"
                       FontSize="15" FontWeight="SemiBold"/>
        </Grid>

        <!-- 文件拖放区域 -->
        <Grid Grid.Row="1" Padding="16,4,16,16" RowSpacing="12"
              AllowDrop="True" DragEnter="DropArea_DragEnter" DragOver="DropArea_DragOver" Drop="DropArea_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="ContentBorder" Grid.Row="0"
                    Background="{ThemeResource CodexSurfaceBrush}"
                    BorderBrush="{ThemeResource CodexBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="10">
                <Grid>
                    <ListView x:Name="ItemsList" ItemsSource="{x:Bind Items}"
                              CanDragItems="True" DragItemsStarting="ItemsList_DragItemsStarting" DragItemsCompleted="ItemsList_DragItemsCompleted"
                              SelectionMode="Multiple" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:StashedItem">
                                <Grid ColumnSpacing="12" Padding="6"
                                      PointerEntered="Item_PointerEntered" PointerExited="Item_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="10" Width="48" Height="48"
                                            Background="{ThemeResource CodexSurfaceBrush}">
                                        <Grid>
                                            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform"
                                                   Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="Uniform"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Path}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" VerticalAlignment="Center"
                                            Width="36" Height="36" MinWidth="0" MinHeight="0" Padding="0"
                                            Opacity="0.72" Click="RemoveItem_Click"
                                            AutomationProperties.Name="移除"
                                            ToolTipService.ToolTip="移除"
                                            Background="Transparent" BorderBrush="Transparent"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <Button.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.15"/>
                                        </Button.OpacityTransition>
                                        <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="EmptyHint" Spacing="5"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind local:FeatureIcons.DragStash}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}" FontSize="20"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="拖放到此处暂存" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="支持文件和文件夹" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="BottomBar" Grid.Row="1">
                <TextBlock x:Name="DragOutHint" Text="拖出项目将移动原文件，不会创建副本。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
