<Window
    x:Class="WinTools.ClipboardHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinTools"
    Title="剪贴板历史">
    <Grid x:Name="ShellRoot" Background="Transparent" Padding="12" KeyDown="Root_KeyDown">
        <local:ClipboardHistoryView x:Name="History"/>
    </Grid>
</Window>
