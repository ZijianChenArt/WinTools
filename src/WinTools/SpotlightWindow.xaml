<?xml version="1.0" encoding="utf-8"?>
<!--
    悬浮搜索窗口（Alt+Space 呼出）。
    这是一个无标题栏的独立窗口，不属于 FeaturePagesHost 的子页面体系，
    所以这里的尺寸不走 Styles/PageStyles.xaml 的页面令牌；窗口高度由
    SpotlightWindow.xaml.cs 里的常量按结果条数算出来，两边必须保持一致。
-->
<Window
    x:Class="WinTools.SpotlightWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinTools"
    Title="悬浮搜索">

    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 输入行。高度必须与 SpotlightWindow.SearchRowHeight 一致。 -->
        <Grid x:Name="SearchRow" Grid.Row="0" Height="60" Padding="18,0,18,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" Glyph="{x:Bind local:FeatureIcons.Search}" FontFamily="{x:Bind local:FeatureIcons.FontFamily}" FontSize="18"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <TextBox x:Name="QueryBox" Grid.Column="1"
                     PlaceholderText="搜索应用程序…"
                     FontSize="20"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     TextChanged="QueryBox_TextChanged"
                     KeyDown="QueryBox_KeyDown">
                <!--
                    TextBox 获得焦点时会用 Focused 一族的主题资源盖掉自身的 BorderThickness /
                    Background，光设 BorderThickness="0" 去不掉那圈强调色边框，必须连资源一起改。
                -->
                <TextBox.Resources>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                </TextBox.Resources>
            </TextBox>
        </Grid>

        <Border x:Name="Separator" Grid.Row="1" Height="1" Visibility="Collapsed"
                Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

        <ListView x:Name="ResultList" Grid.Row="2"
                  Padding="6,6,6,6"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="ResultList_ItemClick"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="52"/>
                    <Setter Property="Height" Value="52"/>
                    <Setter Property="Padding" Value="10,0,10,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SpotlightItem">
                    <Grid ColumnSpacing="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE737;" FontSize="20"
                                      Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Image Source="{x:Bind Icon, Mode=OneWay}"
                                   Visibility="{x:Bind IconVisibility, Mode=OneWay}"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontSize="14"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部提示。高度必须与 SpotlightWindow.FooterHeight 一致。 -->
        <Border x:Name="FooterRow" Grid.Row="3" Height="28" Padding="18,0,18,0" Visibility="Collapsed">
            <TextBlock x:Name="FooterText" FontSize="11" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="↑↓ 选择 · Enter 打开 · Ctrl+Enter 打开所在位置 · Esc 关闭"/>
        </Border>
    </Grid>
</Window>
