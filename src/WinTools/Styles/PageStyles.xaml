<?xml version="1.0" encoding="utf-8"?>
<!--
    WinTools 统一 UI 规范（唯一真源）
    ============================================
    所有功能子页面的间距、圆角、字号、卡片外观都定义在这里。
    页面 XAML 里不要写死 Margin / Padding / CornerRadius / FontSize，也不要写 MaxWidth。
    规范说明见仓库根目录 README.md 第 5 节。

    子页面骨架（固定表头 + 可滚动主体）：

        Grid  PageRootStyle                 行 0 = Auto，行 1 = *
          ├─ Grid  PageHeaderStyle          标题 + 副标题 +（可选）右侧总开关
          └─ 主体（两选一）
               ScrollViewer PageBodyScrollStyle → 卡片堆（设置型页面）
               Grid         PageBodyGridStyle   → 工具条 + 撑满高度的列表（列表型页面）

    主体结构（每一页相同）：
      表头 ─40→ 小节标题行（40 高）─12→ 卡片组 / 列表 ─32→ 下一个小节标题行 …
      · 小节标题行只有两种写法，高度都是 40，文字落在同一条线上：
          PageSectionHeaderFirstTextStyle / PageSectionHeaderTextStyle   卡片组上方
          PageToolbarFirstStyle / PageToolbarStyle                       列表上方（带计数和命令）
      · 帮助类内容统一放在最后一个「使用方法」小节，平铺成卡片，不折叠。

    间距栅格（4 的倍数）：
      4  卡片之间          6  标题与副标题
     12  小节标题 → 内容   16 表单字段之间
     32  二级小节之间      40 页面标题区 → 主体（所有页面相同）
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 空格预览：所有标题信息和必要操作集中在单行，不保留独立工具栏或底栏。 -->
    <Style x:Key="PreviewHeaderStyle" TargetType="Grid">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="ColumnSpacing" Value="8"/>
    </Style>
    <Style x:Key="PreviewTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PreviewCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style x:Key="PreviewContentStyle" TargetType="Grid">
        <Setter Property="Margin" Value="12,0"/>
    </Style>
    <Style x:Key="PreviewTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="16,12"/>
        <Setter Property="IsTextSelectionEnabled" Value="True"/>
    </Style>
    <Style x:Key="PreviewTextSurfaceStyle" TargetType="ScrollViewer">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="PreviewFooterStyle" TargetType="Grid">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="16,4"/>
        <Setter Property="ColumnSpacing" Value="12"/>
    </Style>
    <Style x:Key="PreviewActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="PreviewMediaBarStyle" TargetType="Border">
        <Setter Property="MaxWidth" Value="640"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    </Style>
    <Style x:Key="PreviewMediaButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="PreviewMediaGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="PreviewMediaSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PreviewFallbackTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="PreviewFallbackHintStyle" TargetType="TextBlock" BasedOn="{StaticResource PreviewCaptionStyle}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="TextTrimming" Value="None"/>
    </Style>

    <Style x:Key="PreviewToolbarStyle" TargetType="Grid">
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ColumnSpacing" Value="4"/>
    </Style>
    <Style x:Key="PreviewSheetSelectorStyle" TargetType="ComboBox">
        <Setter Property="MaxWidth" Value="180"/><Setter Property="MinWidth" Value="100"/><Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style x:Key="PreviewViewStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource PreviewCaptionStyle}">
        <Setter Property="Margin" Value="8,0"/>
    </Style>
    <Style x:Key="PreviewReadingBodyStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="24,16"/><Setter Property="Spacing" Value="10"/>
        <Setter Property="MaxWidth" Value="752"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="PreviewReadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="IsTextSelectionEnabled" Value="True"/>
    </Style>
    <Style x:Key="PreviewHeading1Style" TargetType="TextBlock" BasedOn="{StaticResource PreviewReadingTextStyle}">
        <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,12,0,4"/>
    </Style>
    <Style x:Key="PreviewListLevel0Style" TargetType="TextBlock" BasedOn="{StaticResource PreviewReadingTextStyle}"/>
    <Style x:Key="PreviewListLevel1Style" TargetType="TextBlock" BasedOn="{StaticResource PreviewReadingTextStyle}"><Setter Property="Margin" Value="16,0,0,0"/></Style>
    <Style x:Key="PreviewListLevel2Style" TargetType="TextBlock" BasedOn="{StaticResource PreviewReadingTextStyle}"><Setter Property="Margin" Value="32,0,0,0"/></Style>
    <Style x:Key="PreviewListLevel3Style" TargetType="TextBlock" BasedOn="{StaticResource PreviewReadingTextStyle}"><Setter Property="Margin" Value="48,0,0,0"/></Style>
    <Style x:Key="PreviewListLevel4Style" TargetType="TextBlock" BasedOn="{StaticResource PreviewReadingTextStyle}"><Setter Property="Margin" Value="64,0,0,0"/></Style>
    <Style x:Key="PreviewRuleStyle" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}"/></Style>
    <Style x:Key="PreviewEmptyStyle" TargetType="TextBlock" BasedOn="{StaticResource PreviewReadingTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PreviewHeading2Style" TargetType="TextBlock" BasedOn="{StaticResource PreviewHeading1Style}">
        <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style x:Key="PreviewHeading3Style" TargetType="TextBlock" BasedOn="{StaticResource PreviewHeading1Style}">
        <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style x:Key="PreviewCodeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PreviewReadingTextStyle}">
        <Setter Property="FontFamily" Value="Cascadia Mono"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="Margin" Value="12,8"/>
    </Style>
    <Style x:Key="PreviewCodeSurfaceStyle" TargetType="ScrollViewer" BasedOn="{StaticResource PreviewTextSurfaceStyle}">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style x:Key="PreviewQuoteStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="Padding" Value="12,4"/>
    </Style>
    <Style x:Key="PreviewListHeaderStyle" TargetType="Grid">
        <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    </Style>
    <Style x:Key="PreviewListItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="PreviewTableHeaderStyle" TargetType="Grid" BasedOn="{StaticResource PreviewListHeaderStyle}"/>
    <Style x:Key="PreviewListTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PreviewReadingTextStyle}">
        <Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="IsTextSelectionEnabled" Value="False"/>
    </Style>
    <Style x:Key="PreviewTableCellStyle" TargetType="TextBlock" BasedOn="{StaticResource PreviewListTextStyle}">
        <Setter Property="Margin" Value="8,0"/>
    </Style>
    <Style x:Key="PreviewAudioInfoStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PreviewAudioIconStyle" TargetType="FontIcon"><Setter Property="FontSize" Value="40"/></Style>
    <Style x:Key="PreviewHelpTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PreviewReadingTextStyle}">
        <Setter Property="MaxWidth" Value="300"/>
    </Style>

    <Style x:Key="AudioPickerSurfaceStyle" TargetType="Border">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!--
        间距不设独立令牌：值直接写在下面的样式里，改样式即可。
        （之前留过一组 PageSpacing* 的 x:Double，没有任何样式引用它们，
          改了不生效，反而误导人，已删除。）
        圆角：卡片 / 面板 10 在各卡片样式里；这里只留卡片内部小块用的 8，
        因为它要在页面 XAML 里直接引用。
    -->
    <CornerRadius x:Key="PageInnerCornerRadius">8</CornerRadius>
    <Style x:Key="PageDesktopToolTipStyle" TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- ============ 排版 ============ -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="36"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!--
        独立成行的二级小节标题（卡片组上方）。
        Padding 0,8：行高 24 + 上下 8 = 40，与列表工具条 PageToolbarStyle 的 MinHeight 40 一致，
        两种小节标题的文字因此落在同一条线上，切页时第一块内容的位置不跳。
    -->
    <Style x:Key="PageSectionHeaderTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource PageSubtitleTextStyle}">
        <Setter Property="Margin" Value="0,32,0,12"/>
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <!-- 主体里的第一个小节标题：上方不再叠加间距（对应 PageToolbarFirstStyle） -->
    <Style x:Key="PageSectionHeaderFirstTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource PageSectionHeaderTextStyle}">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <!-- 页面副标题 / 说明文字 -->
    <Style x:Key="PageDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- 计数、路径、状态等辅助文字 -->
    <Style x:Key="PageCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- 空列表占位 -->
    <Style x:Key="PageEmptyHintTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource PageDescriptionTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- ============ 页面骨架 ============ -->
    <!-- 子页面根容器：铺满内容列，四周留白统一在这里 -->
    <Style x:Key="PageRootStyle" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="40,24,40,32"/>
        <Setter Property="RowSpacing" Value="0"/>
    </Style>
    <!--
        固定表头：大标题 + 副标题 +（可选）右侧总开关。
        所有页面只用这一个样式：主体第一块永远是一个 40 高的小节标题行（卡片页用
        PageSectionHeaderFirstTextStyle，列表页用 PageToolbarFirstStyle），由它接住表头，
        因此表头 → 主体统一 40，不再区分 40 / 64（原 PageHeaderLooseStyle 已删除）。
    -->
    <Style x:Key="PageHeaderStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,40"/>
        <Setter Property="ColumnSpacing" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="PageHeaderTextStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="MaxWidth" Value="620"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <!-- 设置型页面的主体：卡片堆在这里滚动，表头不动 -->
    <Style x:Key="PageBodyScrollStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollMode" Value="Auto"/>
        <Setter Property="HorizontalScrollMode" Value="Disabled"/>
        <Setter Property="ZoomMode" Value="Disabled"/>
        <Setter Property="Padding" Value="0,0,0,8"/>
    </Style>
    <!-- 列表型页面的主体：行 0 工具条，行 1 撑满剩余高度 -->
    <Style x:Key="PageBodyGridStyle" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <!-- 二级小节工具条（小节标题 + 计数 + 命令栏） -->
    <Style x:Key="PageToolbarStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="ColumnSpacing" Value="12"/>
        <Setter Property="Margin" Value="0,32,0,12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 主体里的第一个工具条：上方不再叠加间距 -->
    <Style x:Key="PageToolbarFirstStyle" TargetType="Grid"
           BasedOn="{StaticResource PageToolbarStyle}">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <!--
        列表工具条的命令按钮（三个列表页共用同一种写法）：
          [图标 + 文字] 主要命令（新建 / 编辑 / 删除） + [⋯] 更多（导入、导出、恢复默认等次要命令）
        不用 CommandBar：它的 MoreButton 是直角、顶部对齐的系统模板，且会接管命令项样式。
        按钮内容固定写成 StackPanel(PageInlineControlsStyle) > FontIcon + TextBlock(PageToolbarLabelTextStyle)，
        窄窗口时 FeaturePagesHost.ApplyDensity 会把文字收起、只留图标（所以每个按钮都要写 ToolTip）。
    -->
    <Style x:Key="PageToolbarButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PageToolbarIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PageToolbarLabelTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PageToolbarIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PageToolbarButtonStyle}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- 列表 + 编辑面板的双栏工作区：高度由所在行给定，不写死 -->
    <Style x:Key="PageWorkAreaStyle" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="240"/>
    </Style>

    <!-- ============ 卡片与面板 ============ -->
    <Style x:Key="PageCardStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="4"/>
    </Style>
    <Style x:Key="PageCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="MinHeight" Value="64"/>
    </Style>
    <Style x:Key="PageListPanelStyle" TargetType="Border"
           BasedOn="{StaticResource PageCardStyle}">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="PageEditPanelStyle" TargetType="Border"
           BasedOn="{StaticResource PageCardStyle}">
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="16,0,0,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <!-- 自带滚动 + 底部按钮条的编辑面板：内边距由内部承担 -->
    <Style x:Key="PageEditPanelHostStyle" TargetType="Border"
           BasedOn="{StaticResource PageEditPanelStyle}">
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="PageTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style x:Key="PageDropAreaStyle" TargetType="Border"
           BasedOn="{StaticResource PageTileStyle}">
        <Setter Property="Padding" Value="2"/>
        <Setter Property="MinHeight" Value="120"/>
    </Style>

    <!-- ============ 列表行内部（DataTemplate 里用） ============ -->
    <!-- 列表行容器：输入法规则页与程序关联页共用同一套行内间距 -->
    <Style x:Key="PageListRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12"/>
        <Setter Property="Padding" Value="8,10"/>
        <Setter Property="MinHeight" Value="48"/>
    </Style>
    <!-- 列表行主标题（应用名 / 程序名） -->
    <Style x:Key="PageListTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- 行尾的强调小按钮（输入法「中文 / 英文」切换）。圆角走卡片内部的 8px。 -->
    <Style x:Key="PageRowChipButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource PageInnerCornerRadius}"/>
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
    </Style>
    <!-- 行首的扩展名徽标 -->
    <Style x:Key="PageRowBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource PageInnerCornerRadius}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
    </Style>
    <Style x:Key="PageRowBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>
    <!-- 分区磁贴内部：图标 / 分区名 / 关键词摘要 -->
    <Style x:Key="PageTileIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="PageTileTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="PageTileCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxLines" Value="3"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- ============ 卡片右侧的输入控件：同类控件同宽，右边缘对齐 ============ -->
    <!-- 快捷键输入框（右侧总跟一个「应用」按钮） -->
    <Style x:Key="PageHotkeyBoxStyle" TargetType="TextBox">
        <Setter Property="Width" Value="200"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PageSettingNumberBoxStyle" TargetType="NumberBox">
        <Setter Property="Width" Value="160"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PageSettingComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="160"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============ 按键提示（「使用方法」小节里的 Enter / Esc 等） ============ -->
    <Style x:Key="PageKeyCapStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="CornerRadius" Value="{StaticResource PageInnerCornerRadius}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PageKeyCapTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- ============ 表单 ============ -->
    <Style x:Key="PageFormStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="16"/>
    </Style>
    <Style x:Key="PageFieldStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="6"/>
    </Style>
    <Style x:Key="PageInlineControlsStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PageActionsStackStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="10"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style x:Key="PagePanelFooterStyle" TargetType="Border">
        <Setter Property="Padding" Value="20,12,20,20"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    </Style>

    <!-- ============ 导航 ============ -->
    <Style x:Key="NavigationGroupHeaderStyle" TargetType="NavigationViewItemHeader">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Padding" Value="16,0,8,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <!-- 原生模板内部写死 40 DIP / 14 号半粗体；保留原生状态名以兼容侧栏收起。 -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NavigationViewItemHeader">
                    <Grid x:Name="NavigationViewItemHeaderRootGrid">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PaneStates">
                                <VisualState x:Name="HeaderTextVisible"/>
                                <VisualState x:Name="HeaderTextCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderText.Visibility" Value="Collapsed"/>
                                        <Setter Target="InnerHeaderGrid.Height" Value="0"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="InnerHeaderGrid" Height="28" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="HeaderText" Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavigationLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
</ResourceDictionary>
